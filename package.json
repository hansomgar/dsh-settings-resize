{
  "name": "dsh-settings-resize",
  "version": "0.1.0",
  "description": "调整 DSH 设置弹窗的宽度、高度与透明度：在「设置 - 通用设置」里用三个滑动条实时调节，并记住选择。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansomgar/dsh-settings-resize.git"
  },
  "homepage": "https://github.com/hansomgar/dsh-settings-resize#readme",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "client/client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
